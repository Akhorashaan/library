# Ключ Google Books. Без него сервис отвечает 429: анонимная квота общая
# на IP-адрес и обычно уже исчерпана. Бесплатно в Google Cloud Console.
GOOGLE_BOOKS_KEY=

# Порт API (фронт в деве живёт на 5183 и проксирует сюда)
PORT=3017

# Внешний порт Docker (интерфейс и API вместе)
LIBRARY_PORT=5183
LIBRARY_HTTPS_PORT=5184
# Адрес компьютера в домашней сети, включённый в HTTPS-сертификат
LIBRARY_HOST=192.168.0.117

# Где лежат база и обложки
DB_PATH=data/kartoteka.db
COVERS_DIR=data/covers
