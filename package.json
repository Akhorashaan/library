{
  "name": "kartoteka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Картотека — домашняя библиотека: каталог, сканер ISBN, списки чтения",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "probe": "node scripts/probe-isbn.mjs",
    "typecheck": "tsc --noEmit",
    "dev:https": "cross-env HTTPS=1 concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"vite --host\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "barcode-detector": "^3.2.2",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.5",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
